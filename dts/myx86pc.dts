            interrupt-parent = <&intc>;
            };

        WRSSIPC0{
            compatible = "WRSIPC";
            interrupts = <0xdf /* Expected to be overwritten by HV queried value */
                          1 0 0 0>;
            interrupt-parent = <&intc>;
            };
#endif /* INCLUDE_HVIF_653 */
    };

