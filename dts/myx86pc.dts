        };

#ifdef DRV_PINMUX_IA
        iomuxConfig{
            iomuxConfig3{
                node = <3>;

                sdcard0: sdcard0
                    {
                    pin-set = <
                    /* muxCtl muxVal */

                    0x5d0 0x42000500
                    0x5e0 0x42000500
                    0x5a0 0x44000400
                    0x5d8 0x44000402
                    0x5b0 0x44000402
                    0x5b8 0x44000402
                    0x5c0 0x44000402
                    0x5c8 0x44000402
                    >;
                    };

            };
        };
#endif /* DRV_PINMUX_IA */
        devparam {
            #address-cells = <1>;
            #size-cells = <0>;
            pciSdhc@0 {
#ifdef DRV_PINMUX_IA
                pinmux-0 = <&sdcard0>;
                gpio_cd = <0xd0c005d0>;
                cd_offset = <0x1>;
#endif /* DRV_PINMUX_IA */
                no-sd = <0>;    /* if 1, do not send SD special commands */
                reg = <0>;      /* dummy */
                };
            };
        };

#ifdef INCLUDE_HVIF_653
        WRSFRM0{
            compatible = "WRFRMSCH";
            interrupts = <0xde /* Expected to be overwritten by HV queried value */
