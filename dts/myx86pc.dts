#include "acpi_export.dtsi"
#endif
#include "prjParams.h"

/   {
    model = "itl_generic";
    compatible = "itl_generic";
    #address-cells = <1>;
    #size-cells = <1>;

    intc: interrupt-controller{
        interrupt-controller;
        #interrupt-cells = <5>;
        max-int-lvl = <255>;
        };

